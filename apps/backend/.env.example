NODE_ENV=development
PORT=3000

# PostgreSQL local (crea la base con: createdb closetai_dev, o desde pgAdmin).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/closetai_dev

# Auth — genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-chars
# Secreto separado para refresh tokens. Si se omite se reutiliza JWT_SECRET.
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-at-least-32-chars
# La sesión muere tras este tiempo SIN ACTIVIDAD del usuario (30s a 24h; acepta
# 45s, 5m, 2h o segundos sueltos). De aquí salen los TTL de los dos JWT y de sus
# cookies: el access token vive la mitad de la ventana y el refresh la ventana
# entera, así que estar activo la desliza y estar inactivo la cierra sola.
SESSION_IDLE_TTL=5m

COOKIE_SECRET=replace-with-random-16-plus-chars
COOKIE_DOMAIN=
# En producción DEBE ser true (cookies sólo sobre HTTPS).
COOKIE_SECURE=false
# lax | strict | none. 'none' requiere COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# Orígenes permitidos por CORS, separados por coma (sin barra final).
CORS_ORIGINS=http://localhost:4200

# RSA para cifrar el password en el cliente (defensa en profundidad sobre HTTPS).
# Genera el valor con: pnpm --filter @closetai/backend gen:rsa
RSA_PRIVATE_KEY_B64=replace-with-base64-encoded-pkcs8-pem

# Raíz de los uploads en disco. Si se omite usa <repo>/storage/uploads.
# Nunca se sirve como carpeta pública: se accede vía GET /api/media?key=...
STORAGE_ROOT=

# Presupuesto y límites de las llamadas a IA. Se aplican antes de llamar al proveedor.
AI_MONTHLY_BUDGET_USD=10
AI_JOB_MAX_ATTEMPTS=3
AI_REQUEST_TIMEOUT_MS=60000

# OpenAI. Sin OPENAI_API_KEY el backend arranca igual y los endpoints de IA
# responden 503 explicándolo; el resto de la app funciona con normalidad.
OPENAI_API_KEY=
# Sólo para apuntar a un proxy o a Azure OpenAI. Vacío usa la API oficial.
OPENAI_BASE_URL=
# Etiquetado por visión (Fase 3). El precio de cada modelo está en
# apps/backend/src/modules/ai/openai-pricing.ts: si cambias el modelo,
# comprueba que tenga entrada allí o el costo se estimará con la tarifa genérica.
OPENAI_VISION_MODEL=gpt-5.6-luna
# auto | low | high. 'low' basta para color, patrón y tipo de prenda.
OPENAI_VISION_IMAGE_DETAIL=low
OPENAI_VISION_MAX_OUTPUT_TOKENS=1200
# Estilista LLM (Fase 4). Sólo texto: recibe los candidatos que ya puntuó el motor,
# nunca el clóset en fotos. Mismo aviso que arriba: si cambias el modelo, comprueba
# que tenga entrada en openai-pricing.ts.
OPENAI_STYLIST_MODEL=gpt-5.6-terra
OPENAI_STYLIST_MAX_OUTPUT_TOKENS=3000
