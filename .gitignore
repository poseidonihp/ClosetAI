# Dependencias
node_modules/
.pnpm-store/

# Builds
dist/
build/
.angular/
out-tsc/

# Turbo / cachés
.turbo/

# TypeScript
*.tsbuildinfo

# Env — se ignora cualquier .env salvo las plantillas de ejemplo
.env
.env.*
!.env.example

# Claves y certificados
*.pem
*.key
*.p12
*.pfx
id_rsa*

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.sw?
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Cobertura de tests. Anclado a la raíz y a los paquetes a propósito: sin anclar,
# `coverage/` casa a cualquier profundidad y se traga
# `apps/backend/src/modules/wardrobe-gaps/coverage/`, que es codigo fuente.
/coverage/
apps/*/coverage/
packages/*/coverage/
*.lcov

# Storage local (uploads de desarrollo). Anclado por el mismo motivo: sin la barra
# inicial tambien oculta `apps/backend/src/storage/`.
/storage/
