# Plantilla del backend en el mini PC. Cópiala a apps/backend/.env y complétala.
# Todo lo que no aparezca aquí toma su valor por defecto del esquema de Zod
# (apps/backend/src/config/env.validation.ts), que es el que manda.

NODE_ENV=production
PORT=3000
# Sólo cloudflared tiene que alcanzar el proceso. Atarlo a loopback deja el
# backend fuera de la red local aunque el cortafuegos de Windows falle.
HOST=127.0.0.1
# OBLIGATORIO detrás de Cloudflare Tunnel: sin esto todas las peticiones llegan
# desde 127.0.0.1 y el límite de peticiones se aplica a todos los usuarios como
# si fueran uno solo.
TRUST_PROXY=true
# El backend sirve además la SPA compilada, así que SPA y API comparten origen y
# el CSP (connect-src 'self') se cumple sin configurar ningún proxy.
SERVE_SPA=true
# Vacío usa apps/frontend/dist/frontend/browser dentro del repo.
SPA_DIST_PATH=

DATABASE_URL=postgresql://closetai:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/closetai

# Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_IDLE_TTL=30m

COOKIE_SECRET=
# El dominio del túnel, sin protocolo. Vacío ata la cookie al host exacto.
COOKIE_DOMAIN=
# En producción el arranque falla si no es true. Cloudflare sirve HTTPS al
# navegador aunque el origen hable HTTP por el túnel, así que la cookie viaja
# segura de verdad.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# SPA y API comparten origen, así que CORS no interviene en el navegador. Se
# declara igual para que una petición de otro origen no quede permitida por olvido.
CORS_ORIGINS=https://closet.tudominio.com

# Genera el valor con: pnpm --filter @closetai/backend gen:rsa
RSA_PRIVATE_KEY_B64=

# Fuera del repo: así un `git clean` o un despliegue no se lleva las fotos.
STORAGE_ROOT=C:\closetai\storage

# Techo por usuario y mes.
AI_MONTHLY_BUDGET_USD=10
# Techo de TODA la instalación. Con varios usuarios el techo por usuario no acota
# el gasto total, y la clave de OpenAI es una sola. Vacío lo deja sin tope.
AI_GLOBAL_MONTHLY_BUDGET_USD=25
AI_JOB_MAX_ATTEMPTS=3
AI_REQUEST_TIMEOUT_MS=60000
AI_IMAGE_REQUEST_TIMEOUT_MS=180000

# Sin OPENAI_API_KEY el backend arranca igual y los endpoints de IA responden 503
# con un mensaje claro: el clóset, el perfil y el motor determinista siguen funcionando.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_VISION_IMAGE_DETAIL=low
OPENAI_VISION_MAX_OUTPUT_TOKENS=1200
OPENAI_STYLIST_MODEL=gpt-5.6-terra
OPENAI_STYLIST_MAX_OUTPUT_TOKENS=3000
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_INPUT_FIDELITY=high
OPENAI_IMAGE_OUTPUT_COMPRESSION=88
